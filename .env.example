# Set these in the Vercel project. Do not commit real values.

# Supplied by the Vercel AWS integration. The aws_s3_tables_ prefixed names
# (aws_s3_tables_AWS_ROLE_ARN, ...) also work.
AWS_ACCOUNT_ID=
AWS_REGION=
AWS_RESOURCE_ARN=
AWS_ROLE_ARN=
S3_TABLE_BUCKET_NAME=

# The catalog table created by `npm run db:migrate`.
S3_TABLES_NAMESPACE=catalog
S3_TABLES_TABLE_NAME=movie_catalog_snapshots
